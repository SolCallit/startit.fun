# ── Supabase (required for anything beyond the public marketing pages) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the screening worker for private evidence storage. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI screening worker (server-only) ──
SCREENING_PROVIDER=anthropic          # anthropic | openai
SCREENING_MODEL=claude-sonnet-5-5     # or an OpenAI model id
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Fine-grained, read-only, public-repo token. Raises GitHub rate limits.
GITHUB_TOKEN=
# The worker signs in as a dedicated user that holds only the `screening_service` role.
SCREENING_SERVICE_EMAIL=
SCREENING_SERVICE_PASSWORD=
CRON_SECRET=   # long random string; the cron endpoint requires 'Authorization: Bearer <CRON_SECRET>'
